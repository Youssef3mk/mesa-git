+++ b/src/gallium/drivers/nouveau/nouveau_buffer.c
@@ -111,8 +111,7 @@ nouveau_buffer_reallocate(struct nouveau_screen *screen,
 {
    nouveau_buffer_release_gpu_storage(buf);
 
-   nouveau_fence_ref(NULL, &buf->fence, screen);
-   nouveau_fence_ref(NULL, &buf->fence_wr, screen);
+   nouveau_fence_ref2(NULL, &buf->fence, &buf->fence_wr, screen);
 
    buf->status &= NOUVEAU_BUFFER_STATUS_REALLOC_MASK;
 
@@ -135,8 +134,7 @@ nouveau_buffer_destroy(struct pipe_screen *pscreen,
    if (res->data && !(res->status & NOUVEAU_BUFFER_STATUS_USER_MEMORY))
       align_free(res->data);
 
-   nouveau_fence_ref(NULL, &res->fence, nouveau_screen(pscreen));
-   nouveau_fence_ref(NULL, &res->fence_wr, nouveau_screen(pscreen));
+   nouveau_fence_ref2(NULL, &res->fence, &res->fence_wr, nouveau_screen(pscreen));
 
    util_range_destroy(&res->valid_buffer_range);
 
@@ -229,8 +227,7 @@ nouveau_transfer_write(struct nouveau_context *nv, struct nouveau_transfer *tx,
    else
       nv->push_data(nv, buf->bo, buf->offset + base, buf->domain, size, data);
 
-   nouveau_fence_ref(nv->fence, &buf->fence, nv->screen);
-   nouveau_fence_ref(nv->fence, &buf->fence_wr, nv->screen);
+   nouveau_fence_ref2(nv->fence, &buf->fence, &buf->fence_wr, nv->screen);
 }
 
 /* Does a CPU wait for the buffer's backing data to become reliably accessible
@@ -255,7 +252,8 @@ nouveau_buffer_sync(struct nouveau_context *nv,
       if (!nouveau_fence_wait(buf->fence, &nv->debug))
          return false;
 
-      nouveau_fence_ref(NULL, &buf->fence, nv->screen);
+      nouveau_fence_ref2(NULL, &buf->fence, &buf->fence_wr, nv->screen);
+      return true;
    }
    nouveau_fence_ref(NULL, &buf->fence_wr, nv->screen);
 
@@ -593,8 +591,7 @@ nouveau_copy_buffer(struct nouveau_context *nv,
                     src->bo, src->offset + srcx, src->domain, size);
 
       dst->status |= NOUVEAU_BUFFER_STATUS_GPU_WRITING;
-      nouveau_fence_ref(nv->fence, &dst->fence, nv->screen);
-      nouveau_fence_ref(nv->fence, &dst->fence_wr, nv->screen);
+      nouveau_fence_ref2(nv->fence, &dst->fence, &dst->fence_wr, nv->screen);
 
       src->status |= NOUVEAU_BUFFER_STATUS_GPU_READING;
       nouveau_fence_ref(nv->fence, &src->fence, nv->screen);
diff --git a/src/gallium/drivers/nouveau/nouveau_fence.c b/src/gallium/drivers/nouveau/nouveau_fence.c
index e3f4da98677b..79d4f80627c3 100644
--- a/src/gallium/drivers/nouveau/nouveau_fence.c
+++ b/src/gallium/drivers/nouveau/nouveau_fence.c
@@ -40,12 +40,21 @@ nouveau_fence_new(struct nouveau_context *nv, struct nouveau_fence **fence)
    if (!new_fence)
       return false;
 
-   int ret = nouveau_bo_new(nv->screen->device, NOUVEAU_BO_GART, 0x1000, 0x1000, NULL, &new_fence->bo);
-   if (ret) {
-      FREE(new_fence);
-      return false;
+   struct nouveau_fence_list *fence_list = &nv->screen->fence;
+   struct nouveau_bo *bo = NULL;
+
+   if (fence_list->bo_cache_count > 0)
+      bo = fence_list->bo_cache[--fence_list->bo_cache_count];
+
+   if (!bo) {
+      int ret = nouveau_bo_new(nv->screen->device, NOUVEAU_BO_GART, 0x1000, 0x1000, NULL, &bo);
+      if (ret) {
+         FREE(new_fence);
+         return false;
+      }
    }
 
+   new_fence->bo = bo;
    new_fence->screen = nv->screen;
    new_fence->context = nv;
    new_fence->ref = 1;
@@ -126,10 +135,23 @@ nouveau_fence_del(struct nouveau_fence *fence)
       nouveau_fence_trigger_work(fence);
    }
 
-   nouveau_bo_ref(NULL, &fence->bo);
+   if (fence_list->bo_cache_count < NOUVEAU_FENCE_BO_CACHE_SIZE) {
+      fence_list->bo_cache[fence_list->bo_cache_count++] = fence->bo;
+   } else {
+      nouveau_bo_ref(NULL, &fence->bo);
+   }
    FREE(fence);
 }
 
+void
+nouveau_fence_list_destroy(struct nouveau_fence_list *fence_list)
+{
+   for (unsigned i = 0; i < fence_list->bo_cache_count; i++)
+      nouveau_bo_ref(NULL, &fence_list->bo_cache[i]);
+   fence_list->bo_cache_count = 0;
+   simple_mtx_destroy(&fence_list->lock);
+}
+
 void
 nouveau_fence_cleanup(struct nouveau_context *nv)
 {
@@ -357,6 +379,9 @@ void
 nouveau_fence_ref(struct nouveau_fence *fence, struct nouveau_fence **ref,
                   struct nouveau_screen *screen)
 {
+   if (!fence && (!ref || !*ref))
+      return;
+
    struct nouveau_fence_list *fence_list = &screen->fence;
 
    simple_mtx_lock(&fence_list->lock);
@@ -364,6 +389,23 @@ nouveau_fence_ref(struct nouveau_fence *fence, struct nouveau_fence **ref,
    simple_mtx_unlock(&fence_list->lock);
 }
 
+void
+nouveau_fence_ref2(struct nouveau_fence *fence, struct nouveau_fence **ref1,
+                   struct nouveau_fence **ref2, struct nouveau_screen *screen)
+{
+   if (!fence && (!ref1 || !*ref1) && (!ref2 || !*ref2))
+      return;
+
+   struct nouveau_fence_list *fence_list = &screen->fence;
+
+   simple_mtx_lock(&fence_list->lock);
+   if (ref1)
+      _nouveau_fence_ref(fence, ref1);
+   if (ref2)
+      _nouveau_fence_ref(fence, ref2);
+   simple_mtx_unlock(&fence_list->lock);
+}
+
 bool
 nouveau_fence_wait(struct nouveau_fence *fence, struct util_debug_callback *debug)
 {
