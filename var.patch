From: Mary Guillemard <mary@mary.zone>
Date: Wed, 25 Nov 2026 18:46:16 +0100
Subject: [PATCH 3/3] nak/hw_tests: Fix test_op_fmnmx for pre-Ampere

Skip unsupported configurations on older gens.

Signed-off-by: Mary Guillemard <mary@mary.zone>
Co-authored-by: Karol Herbst <git@karolherbst.de>
---
 src/nouveau/compiler/nak/hw_tests.rs | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/nouveau/compiler/nak/hw_tests.rs b/src/nouveau/compiler/nak/hw_tests.rs
index d9e935e6cac6..04583818bcd6 100644
--- a/src/nouveau/compiler/nak/hw_tests.rs
+++ b/src/nouveau/compiler/nak/hw_tests.rs
@@ -3063,14 +3063,21 @@ fn get_foldable_f32(a: &mut Acorn) -> u32 {
 
 #[test]
 pub fn test_op_fmnmx() {
-    for bits in 0..=0x7 {
+    let run = &RunSingleton::get();
+    let max = match run.sm.sm() {
+        x if x >= 86 => 0x7,
+        x if x >= 80 => 0x3,
+        _ => 0x1,
+    };
+
+    for bits in 0..=max {
         let op = OpFMnMx {
             dst: Dst::None,
             srcs: [0.into(), 0.into()],
-            min: (bits & 0x4 == 0x4).into(),
+            min: (bits & 0x1 == 0x1).into(),
             ftz: false,
             nan: bits & 0x2 == 0x2,
-            xorsign: bits & 0x1 == 0x1,
+            xorsign: bits & 0x4 == 0x4,
         };
 
         let mut a = Acorn::new();
