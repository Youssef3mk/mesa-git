From 3c4301bb1f64e195c35c3b8d64f157233f4f36e5 Mon Sep 17 00:00:00 2001
From: Mary Guillemard <mary@mary.zone>
Date: Wed, 25 Nov 2026 15:06:40 +0100
Subject: [PATCH 1/3] nouveau/winsys: Early error out if no video decode class
 is found

We currently ignore the class output and try to allocate a class 0
causing asserts on pre-Turing if built in debug mode.

This patch fixes this by checking if the object class is valid first.

Signed-off-by: Mary Guillemard <mary@mary.zone>
Fixes: d967121a169 ("nouveau/winsys: Add video context support")
---
 src/nouveau/winsys/nouveau_context.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/nouveau/winsys/nouveau_context.c b/src/nouveau/winsys/nouveau_context.c
index 00551d9f05c1..69486e29a455 100644
--- a/src/nouveau/winsys/nouveau_context.c
+++ b/src/nouveau/winsys/nouveau_context.c
@@ -242,6 +242,12 @@ nouveau_ws_video_context_init(struct nouveau_ws_device *dev,
 
    if (engines & NOUVEAU_WS_ENGINE_VDEC) {
       uint32_t obj_class = nouveau_ws_context_find_class(classes, 0xb0);
+
+      if (!obj_class) {
+         ret = -EINVAL;
+         goto fail_subchan;
+      }
+
       ret = nouveau_ws_subchan_alloc(dev->fd, req.channel, base | 0x00b0,
                                      obj_class, &ctx->vdec);
       if (ret)
