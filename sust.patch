From b6466c2dc836c2e1537a365ca40799d00c95c30f Mon Sep 17 00:00:00 2001
From: Mel Henning <mhenning@darkrefraction.com>
Date: Tue, 24 Nov 2026 17:56:51 -0500
Subject: [PATCH 2/2] nak: Lower 64-bit sustga to 32-bit

Fixes: e5d4c4934d7 ("nak: Add an image address lowering pass")
---
 src/nouveau/compiler/nak_nir_lower_image_addrs.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/nouveau/compiler/nak_nir_lower_image_addrs.c b/src/nouveau/compiler/nak_nir_lower_image_addrs.c
index 150c891f92b7..809bb2bc5b16 100644
--- a/src/nouveau/compiler/nak_nir_lower_image_addrs.c
+++ b/src/nouveau/compiler/nak_nir_lower_image_addrs.c
@@ -462,7 +462,16 @@ lower_image_access(nir_builder *b, nir_intrinsic_instr *intrin)
    }
    case nir_intrinsic_image_deref_store: {
       nir_def *fmt = load_su_info(b, deref, format_info);
-      nir_sustga_nv(b, addr, fmt, is_oob, intrin->src[3].ssa,
+      nir_def *data = intrin->src[3].ssa;
+
+      if (data->bit_size == 64) {
+         /* See also shrink_image_store in nak_nir_lower_tex.c */
+         assert(format == PIPE_FORMAT_R64_UINT ||
+                format == PIPE_FORMAT_R64_SINT);
+         data = nir_unpack_64_2x32(b, nir_channel(b, data, 0));
+      }
+
+      nir_sustga_nv(b, addr, fmt, is_oob, data,
                     .access = nir_intrinsic_access(intrin),
                     .flags = offset_mode);
       break;
-- 
