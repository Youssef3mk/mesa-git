From 5645fb692234a0eb62bb4fab0edfe6a82f7c381e Mon Sep 17 00:00:00 2001
From: Francesco Stimola
 <1268108-francesco-stimola@users.noreply.gitlab.freedesktop.org>
Date: Sun, 18 Oct 2026 19:07:22 +0200
Subject: [PATCH 01/10] nv50: size surface views by blocks when the block size
 differs

The VA frontend clears YUYV and UYVY video buffers, whose R8G8_R8B8 and
G8R8_B8R8 resources hold two pixels per block, through RGBA8 surfaces.
nv50_surface_from_miptree sizes the surface in pixels, so the render
target is twice as wide as the buffer. Clears do not cover it today
because they read their templates as nv50_surface; once they do, they
write past the buffer and raise RT_FAULT traps.

Convert the size to blocks of the view format, as radeonsi does.

Backport-to: *
Tested-by: Kush Chandak <kushc451@gmail.com>
Generated-by: Claude Code (Claude Opus 5.5)
---
 src/gallium/drivers/nouveau/nv50/nv50_miptree.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/gallium/drivers/nouveau/nv50/nv50_miptree.c b/src/gallium/drivers/nouveau/nv50/nv50_miptree.c
index bcd6e6a5327c..ffd0ecefa592 100644
--- a/src/gallium/drivers/nouveau/nv50/nv50_miptree.c
+++ b/src/gallium/drivers/nouveau/nv50/nv50_miptree.c
@@ -485,6 +485,19 @@ nv50_surface_from_miptree(struct nv50_miptree *mt,
    ns->depth = ps->last_layer - ps->first_layer + 1;
    ns->offset = mt->level[templ->level].offset;
 
+   /* A view in a format with another block size, such as RGBA8 on a
+    * subsampled R8G8_R8B8 video buffer, covers the same blocks.
+    */
+   if (util_format_get_blockwidth(ps->format) !=
+       util_format_get_blockwidth(mt->base.base.format) ||
+       util_format_get_blockheight(ps->format) !=
+       util_format_get_blockheight(mt->base.base.format)) {
+      ns->width = util_format_get_nblocksx(mt->base.base.format, ns->width) *
+                  util_format_get_blockwidth(ps->format);
+      ns->height = util_format_get_nblocksy(mt->base.base.format, ns->height) *
+                   util_format_get_blockheight(ps->format);
+   }
+
    ns->width <<= mt->ms_x;
    ns->height <<= mt->ms_y;
 
-- 
