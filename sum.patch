From f5a46385abae43156ef29eb8a7031fe508cf6c71 Mon Sep 17 00:00:00 2001
From: Francesco Stimola
 <1268108-francesco-stimola@users.noreply.gitlab.freedesktop.org>
Date: Sat, 17 Oct 2026 21:34:25 +0200
Subject: [PATCH 07/10] nouveau: wait for the video engines before destroying a
 vp3 decoder

Destroying a decoder while the engines are still busy leaves the channel
unable to idle, and the next decoder hangs the GPU in g84_ectx_bind.
This happens when a player stops a video mid-decode.

Wait for the engine buffers before tearing the decoder down.

Backport-to: *
Tested-by: Kush Chandak <kushc451@gmail.com>
Generated-by: Claude Code (Claude Opus 5.5)
---
 .../drivers/nouveau/nouveau_vp3_video.c        | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/gallium/drivers/nouveau/nouveau_vp3_video.c b/src/gallium/drivers/nouveau/nouveau_vp3_video.c
index 5130ed6d6386..7753f22764fa 100644
--- a/src/gallium/drivers/nouveau/nouveau_vp3_video.c
+++ b/src/gallium/drivers/nouveau/nouveau_vp3_video.c
@@ -205,8 +205,26 @@ static void
 nouveau_vp3_decoder_destroy(struct pipe_video_codec *decoder)
 {
    struct nouveau_vp3_decoder *dec = (struct nouveau_vp3_decoder *)decoder;
+   struct nouveau_bo *engine_bos[] = {
+      dec->ref_bo, dec->bitplane_bo, dec->inter_bo[0], dec->inter_bo[1],
+   };
+   unsigned b;
    int i;
 
+   /* The engines may still be working through the last pictures. If their
+    * objects and channels go away now, the kernel cannot idle the channel
+    * and the next decoder that binds the engines hangs the GPU. Every stage
+    * reads or writes one of these buffers, so wait for them first.
+    */
+   for (b = 0; b < ARRAY_SIZE(engine_bos); ++b) {
+      if (engine_bos[b])
+         nouveau_bo_wait(engine_bos[b], NOUVEAU_BO_RDWR, dec->client);
+   }
+   for (i = 0; i < NOUVEAU_VP3_VIDEO_QDEPTH; ++i) {
+      if (dec->bsp_bo[i])
+         nouveau_bo_wait(dec->bsp_bo[i], NOUVEAU_BO_RDWR, dec->client);
+   }
+
    nouveau_bo_ref(NULL, &dec->ref_bo);
    nouveau_bo_ref(NULL, &dec->bitplane_bo);
    nouveau_bo_ref(NULL, &dec->inter_bo[0]);
