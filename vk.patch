From 6efae4c2b8513e0da6bfa072f9c61892921b09dd Mon Sep 17 00:00:00 2001
From: Anusha Srivatsa <asrivats@redhat.com>
Date: Wed, 23 Sep 2026 17:18:07 -0500
Subject: [PATCH 3/3] nvk: advertise VK_KHR_draw_indirect_count for pre-Turing

Now that both indexed and non-indexed indirect count draw paths are
implemented for pre-Turing GPUs, remove the Turing gate on the
extension and feature bit.

Signed-off-by: Anusha Srivatsa <asrivats@redhat.com>
---
 src/nouveau/vulkan/nvk_physical_device.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_physical_device.c b/src/nouveau/vulkan/nvk_physical_device.c
index 1447c85311ea..fc1d19af710d 100644
--- a/src/nouveau/vulkan/nvk_physical_device.c
+++ b/src/nouveau/vulkan/nvk_physical_device.c
@@ -136,7 +136,7 @@ nvk_get_device_extensions(const struct nvk_instance *instance,
       .KHR_descriptor_update_template = true,
       .KHR_device_address_commands = true,
       .KHR_device_group = true,
-      .KHR_draw_indirect_count = info->cls_eng3d >= TURING_A,
+      .KHR_draw_indirect_count = true,
       .KHR_driver_properties = true,
       .KHR_dynamic_rendering = true,
       .KHR_dynamic_rendering_local_read = true,
@@ -420,7 +420,7 @@ nvk_get_device_features(const struct nv_device_info *info,
 
       /* Vulkan 1.2 */
       .samplerMirrorClampToEdge = true,
-      .drawIndirectCount = info->cls_eng3d >= TURING_A,
+      .drawIndirectCount = true,
       .storageBuffer8BitAccess = true,
       .uniformAndStorageBuffer8BitAccess = true,
       .storagePushConstant8 = true,
