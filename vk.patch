diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index 626fbcb71df9..0c534d8847c0 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -1288,6 +1288,9 @@ void
 nvk_cmd_buffer_flush_push_descriptors(struct nvk_cmd_buffer *cmd,
                                       struct nvk_descriptor_state *desc)
 {
+   if (desc->push_dirty == 0)
+      return;
+
    struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
    const struct nvk_physical_device *pdev = nvk_device_physical(dev);
    const uint32_t min_cbuf_alignment = nvk_min_cbuf_alignment(&pdev->info);
diff --git a/src/nouveau/vulkan/nvk_cmd_draw.c b/src/nouveau/vulkan/nvk_cmd_draw.c
index f77181f10d1a..78f6c82f3ffa 100644
--- a/src/nouveau/vulkan/nvk_cmd_draw.c
+++ b/src/nouveau/vulkan/nvk_cmd_draw.c
@@ -2421,11 +2421,17 @@ nvk_mme_set_vb_stride(struct mme_builder *b)
 static void
 nvk_flush_vi_state(struct nvk_cmd_buffer *cmd)
 {
-   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
-   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
    const struct vk_dynamic_graphics_state *dyn =
       &cmd->vk.dynamic_graphics_state;
 
+   if (!BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VI) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VI_BINDINGS_VALID) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VI_BINDING_STRIDES))
+      return;
+
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 258);
 
    if (BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VI_BINDINGS_VALID)) {
@@ -2567,6 +2573,11 @@ nvk_flush_ts_state(struct nvk_cmd_buffer *cmd)
 {
    const struct vk_dynamic_graphics_state *dyn =
       &cmd->vk.dynamic_graphics_state;
+
+   if (!BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_TS_PATCH_CONTROL_POINTS) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_TS_DOMAIN_ORIGIN))
+      return;
+
    struct nv_push *p = nvk_cmd_buffer_push(cmd, 4);
 
    if (BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_TS_PATCH_CONTROL_POINTS)) {
@@ -2716,6 +2727,15 @@ nvk_flush_vp_state(struct nvk_cmd_buffer *cmd)
    */
    const bool vp_broadcast_dirty = BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_FSR) &&
                                    nvk_cmd_buffer_3d_cls(cmd) == TURING_A;
+
+   if (!BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VP_VIEWPORTS) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VP_DEPTH_CLIP_NEGATIVE_ONE_TO_ONE) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VP_DEPTH_CLAMP_RANGE) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VP_SCISSOR_COUNT) &&
+       !BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_VP_SCISSORS) &&
+       !vp_broadcast_dirty)
+      return;
+
    const bool need_turing_vp_broadcast = nvk_cmd_buffer_3d_cls(cmd) == TURING_A &&
                                          !vk_fragment_shading_rate_is_disabled(&dyn->fsr);
    const uint8_t viewport_count = need_turing_vp_broadcast ? NVK_MAX_VIEWPORTS :
@@ -2951,9 +2971,14 @@ nvk_mme_set_z_clamp(struct mme_builder *b)
 static void
 nvk_flush_rs_state(struct nvk_cmd_buffer *cmd)
 {
-   const struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
    const struct vk_dynamic_graphics_state *dyn =
       &cmd->vk.dynamic_graphics_state;
+
+   if (!BITSET_TEST_RANGE(dyn->dirty, MESA_VK_DYNAMIC_RS_RASTERIZER_DISCARD_ENABLE,
+                                      MESA_VK_DYNAMIC_RS_LINE_STIPPLE))
+      return;
+
+   const struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
    const struct nvk_rendering_state *render =
       &cmd->state.gfx.render;
 
@@ -3846,12 +3871,16 @@ vk_to_nv9097_stencil_op(VkStencilOp vk_op)
 static void
 nvk_flush_ds_state(struct nvk_cmd_buffer *cmd)
 {
-   struct nv_push *p = nvk_cmd_buffer_push(cmd, 35);
-
-   const struct nvk_rendering_state *render = &cmd->state.gfx.render;
    const struct vk_dynamic_graphics_state *dyn =
       &cmd->vk.dynamic_graphics_state;
 
+   if (!BITSET_TEST_RANGE(dyn->dirty, MESA_VK_DYNAMIC_DS_DEPTH_TEST_ENABLE,
+                                      MESA_VK_DYNAMIC_DS_STENCIL_REFERENCE))
+      return;
+
+   const struct nvk_rendering_state *render = &cmd->state.gfx.render;
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 35);
+
    if (BITSET_TEST(dyn->dirty, MESA_VK_DYNAMIC_DS_DEPTH_TEST_ENABLE)) {
       bool enable = dyn->ds.depth.test_enable &&
                     render->depth_att.vk_format != VK_FORMAT_UNDEFINED;
@@ -4052,10 +4081,14 @@ nvk_mme_set_write_mask(struct mme_builder *b)
 static void
 nvk_flush_cb_state(struct nvk_cmd_buffer *cmd)
 {
-   struct nvk_rendering_state *render = &cmd->state.gfx.render;
    const struct vk_dynamic_graphics_state *dyn =
