From 8e33e93807886be71c44b06f7c0da019e1c4ce57 Mon Sep 17 00:00:00 2001
From: Anusha Srivatsa <asrivats@redhat.com>
Date: Tue, 22 Sep 2026 14:57:53 -0500
Subject: [PATCH 1/3] nvk: add indirect count draw support for pre-Turing

Pre-Turing GPUs cannot use mme_tu104_read_fifoed() to read the draw
count from GPU memory. Use indirect push to send the draw count
and draw parameter addresses to the MME, which
reads and processes the values from the FIFO directly.

Remaining FIFO entries for draws beyond the actual count are drained
in a second loop to keep the FIFO synchronized.

Signed-off-by: Anusha Srivatsa <asrivats@redhat.com>
Assisted-by: LLM
---
 src/nouveau/vulkan/nvk_cmd_draw.c | 127 ++++++++++++++++++++++--------
 1 file changed, 94 insertions(+), 33 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_cmd_draw.c b/src/nouveau/vulkan/nvk_cmd_draw.c
index d16c34a80e10..f7daabb54a7e 100644
--- a/src/nouveau/vulkan/nvk_cmd_draw.c
+++ b/src/nouveau/vulkan/nvk_cmd_draw.c
@@ -5393,31 +5393,80 @@ nvk_CmdDrawIndexedIndirect2KHR(VkCommandBuffer commandBuffer,
 void
 nvk_mme_draw_indirect_count(struct mme_builder *b)
 {
-   if (b->devinfo->cls_eng3d < TURING_A)
-      return;
+   if (b->devinfo->cls_eng3d >= TURING_A) {
+      struct mme_value64 draw_addr = mme_load_addr64(b);
+      struct mme_value64 draw_count_addr = mme_load_addr64(b);
+      struct mme_value draw_max = mme_load(b);
+      struct mme_value64 stride = mme_load_addr64(b);
 
-   struct mme_value64 draw_addr = mme_load_addr64(b);
-   struct mme_value64 draw_count_addr = mme_load_addr64(b);
-   struct mme_value draw_max = mme_load(b);
-   struct mme_value64 stride = mme_load_addr64(b);
+      mme_tu104_read_fifoed(b, draw_count_addr, mme_imm(1));
+      mme_free_reg64(b, draw_count_addr);
+      struct mme_value draw_count_buf = mme_load(b);
 
-   mme_tu104_read_fifoed(b, draw_count_addr, mme_imm(1));
-   mme_free_reg64(b, draw_count_addr);
-   struct mme_value draw_count_buf = mme_load(b);
+      mme_if(b, ule, draw_count_buf, draw_max) {
+         mme_mov_to(b, draw_max, draw_count_buf);
+      }
+      mme_free_reg(b, draw_count_buf);
 
-   mme_if(b, ule, draw_count_buf, draw_max) {
-      mme_mov_to(b, draw_max, draw_count_buf);
-   }
-   mme_free_reg(b, draw_count_buf);
+      struct mme_value draw = mme_mov(b, mme_zero());
+      mme_while(b, ult, draw, draw_max) {
+         mme_tu104_read_fifoed(b, draw_addr, mme_imm(4));
 
-   struct mme_value draw = mme_mov(b, mme_zero());
-   mme_while(b, ult, draw, draw_max) {
-      mme_tu104_read_fifoed(b, draw_addr, mme_imm(4));
+         nvk_mme_build_draw(b, draw);
 
-      nvk_mme_build_draw(b, draw);
+         mme_add_to(b, draw, draw, mme_imm(1));
+         mme_add64_to(b, draw_addr, draw_addr, stride);
+      }
+   } else {
+      struct mme_value max_draw_count = mme_load(b);
+      nvk_mme_load_to_scratch(b, DRAW_PAD_DW);
+      struct mme_value draw_count = mme_load(b);
 
-      mme_add_to(b, draw, draw, mme_imm(1));
-      mme_add64_to(b, draw_addr, draw_addr, stride);
+      struct mme_value total_draws = mme_mov(b, max_draw_count);
+
+      struct mme_value diff = mme_sub(b, max_draw_count, draw_count);
+      struct mme_value sign = mme_merge(b, mme_zero(), diff, 0, 1, 31);
+      mme_free_reg(b, diff);
+      mme_if(b, ieq, sign, mme_zero()) {
+         mme_mov_to(b, max_draw_count, draw_count);
+      }
+      mme_free_reg(b, sign);
+      mme_free_reg(b, draw_count);
+
+      struct mme_value draw = mme_mov(b, mme_zero());
+      mme_while(b, ine, draw, max_draw_count) {
+         nvk_mme_spill(b, DRAW_COUNT, max_draw_count);
+
+         nvk_mme_build_draw(b, draw);
+
+         mme_add_to(b, draw, draw, mme_imm(1));
+
+         struct mme_value pad_dw = nvk_mme_load_scratch(b, DRAW_PAD_DW);
+         mme_loop(b, pad_dw) {
+            mme_free_reg(b, mme_load(b));
+         }
+         mme_free_reg(b, pad_dw);
+         nvk_mme_unspill(b, DRAW_COUNT, max_draw_count);
+      }
+
+      mme_while(b, ine, draw, total_draws) {
+         mme_free_reg(b, mme_load(b));
+         mme_free_reg(b, mme_load(b));
+         mme_free_reg(b, mme_load(b));
+         mme_free_reg(b, mme_load(b));
+
+         mme_add_to(b, draw, draw, mme_imm(1));
+
+         struct mme_value pad_dw = nvk_mme_load_scratch(b, DRAW_PAD_DW);
+         mme_loop(b, pad_dw) {
+            mme_free_reg(b, mme_load(b));
+         }
+         mme_free_reg(b, pad_dw);
+      }
+
+      mme_free_reg(b, draw);
+      mme_free_reg(b, max_draw_count);
+      mme_free_reg(b, total_draws);
    }
 }
 
@@ -5427,22 +5476,34 @@ nvk_CmdDrawIndirectCount2KHR(VkCommandBuffer commandBuffer,
 {
    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
 
-   /* TODO: Indirect count draw pre-Turing */
-   assert(nvk_cmd_buffer_3d_cls(cmd) >= TURING_A);
-
    nvk_cmd_flush_gfx_state(cmd);
 
-   struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
-   P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_DRAW_INDIRECT_COUNT));
-   uint64_t draw_addr = pInfo->addressRange.address;
-   P_INLINE_DATA(p, draw_addr >> 32);
-   P_INLINE_DATA(p, draw_addr);
-   uint64_t draw_count_addr = pInfo->countAddressRange.address;
-   P_INLINE_DATA(p, draw_count_addr >> 32);
-   P_INLINE_DATA(p, draw_count_addr);
-   P_INLINE_DATA(p, pInfo->maxDrawCount);
-   P_INLINE_DATA(p, pInfo->addressRange.stride >> 32);
-   P_INLINE_DATA(p, pInfo->addressRange.stride);
+   if (nvk_cmd_buffer_3d_cls(cmd) >= TURING_A) {
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
+      P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_DRAW_INDIRECT_COUNT));
+      uint64_t draw_addr = pInfo->addressRange.address;
+      P_INLINE_DATA(p, draw_addr >> 32);
+      P_INLINE_DATA(p, draw_addr);
+      uint64_t draw_count_addr = pInfo->countAddressRange.address;
+      P_INLINE_DATA(p, draw_count_addr >> 32);
+      P_INLINE_DATA(p, draw_count_addr);
+      P_INLINE_DATA(p, pInfo->maxDrawCount);
+      P_INLINE_DATA(p, pInfo->addressRange.stride >> 32);
+      P_INLINE_DATA(p, pInfo->addressRange.stride);
+   } else {
+      uint64_t draw_addr = pInfo->addressRange.address;
+      uint32_t stride = pInfo->addressRange.stride;
+      uint64_t draw_count_addr = pInfo->countAddressRange.address;
+      uint32_t pad_dw = (stride - sizeof(VkDrawIndirectCommand)) / 4;
+      uint64_t range = pInfo->maxDrawCount * stride;
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 3);
+      P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_DRAW_INDIRECT_COUNT));
+      P_INLINE_DATA(p, pInfo->maxDrawCount);
+      P_INLINE_DATA(p, pad_dw);
+      nv_push_update_count(p, 1 + range / 4);
+      nvk_cmd_buffer_push_indirect(cmd, draw_count_addr, 4);
+      nvk_cmd_buffer_push_indirect(cmd, draw_addr, range);
+    }
 }
 
 void
